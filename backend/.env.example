NODE_ENV=development
PORT=3001
# Used when running the API on your machine; Docker Compose overrides it
DATABASE_URL=postgresql://app:app@localhost:5432/doctor_booking

# Which providers to use
LLM_PROVIDER=gemini            # claude | gemini
EMBEDDING_PROVIDER=gemini      # voyage | gemini

# API keys (set the ones your providers need)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Models (check the provider docs: names get retired)
LLM_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1024      # must match vector(1024) in the schema

# Retrieval
TOP_K=4
SIMILARITY_THRESHOLD=0.5